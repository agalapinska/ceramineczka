# Notion integration — create an internal integration at https://www.notion.so/profile/integrations
# and share the "Produkty - Ceramika" database with it.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxx

# Optional: override if the data source ID changes.
# Default is the current "Produkty - Ceramika" data source.
# NOTION_DATA_SOURCE_ID=349ec94a-fa69-8049-910c-000b4bed2fc7

# Formularze (kontakt, newsletter) zapisują do Notion — strona „Ceramineczka — formularze”.
# Integracja z NOTION_TOKEN musi mieć dostęp do tej strony (••• → Connections).
# Domyślne ID są w lib/forms.ts; nadpisz tylko, jeśli bazy się zmienią.
# NOTION_CONTACT_DATA_SOURCE_ID=f9f60eed-371f-402f-b09e-b7f94447bcad
# NOTION_NEWSLETTER_DATA_SOURCE_ID=fb2924a5-88fe-4216-9b07-2adc544b4822

# Stripe — create keys at https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_..., pk_test_...) podczas developmentu.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Webhook signing secret — wygenerowany przez `stripe listen` lub w dashboardzie.
# Wymagany dla /api/stripe/webhook (potwierdzenia zamówień, zmiana statusu w Notion).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Publiczny URL aplikacji — używany jako fallback przy budowie URL-i success/cancel.
# Lokalnie: http://localhost:3000 ; produkcja: https://twoja-domena.pl
NEXT_PUBLIC_SITE_URL=http://localhost:3000
